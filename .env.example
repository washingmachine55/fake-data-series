# Copy to .env (Bun loads it automatically). Every value has a default; set real ones
# anywhere the server is reachable by others.
PORT=4070
STUB_API_KEY=stub-api-key
STUB_BEARER_TOKEN=stub-bearer-token
STUB_CLIENT_ID=stub-client
STUB_CLIENT_SECRET=stub-secret
# Requests that would generate more records than this get a 400.
STUB_MAX_RECORDS=100000
