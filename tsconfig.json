{
  "compilerOptions": {
    // Environment setup & latest features
    // Web-standard globals only (fetch, Response, URL, streams…), so the app type-checks
    // on any host without runtime type packages.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // No runtime type packages: a deploy build that lacks @types/bun can't fail on them.
    // Bun-only files (server.ts, scripts/) reference Bun's types themselves.
    "types": [],

    // Node's ESM rules: Vercel runs each compiled file with Node, which needs full relative
    // paths ("./app.js", "./datasets/index.js"). tsc rejects imports without them.
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
